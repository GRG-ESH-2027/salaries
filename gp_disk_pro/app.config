        <add name="gp_disk_pro.My.MySettings.gp_tafrgh_dbConnectionString1" connectionString="Provider=Microsoft.ACE.OLEDB.12.0;Data Source=&quot;J:\برنامج دفتر اوامر الدفع -بيسك\2\برنامج دفتر اوامر الدفع -بيسك\source\gp_tafrgh_db.accdb&quot;" providerName="System.Data.OleDb"/>
